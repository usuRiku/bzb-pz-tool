<% layout("layouts/boilerplate") %>
<% layout("layouts/boilerplate") %>
<div class="row">
    <div class="col-12 col-md-8 offset-md-2">
        <h1>ライブ一覧</h1>
        <form action = "/lives/search" role="search">
            <div class="row d-flex mb-2">
                <div class="col-12">
                    <input class="form-control" type="search" name= "livename" placeholder="ライブ名" aria-label="Search">
                </div>
            </div>
            <div class="d-flex justify-content-end">
                <a class="mb-1" data-bs-toggle="collapse" href="#collapseDetailSearch" aria-expanded="false" aria-controls="collapseDetailSearch">
                    詳細検索▽
                </a>
            </div>
            <div class="collapse mb-1" id="collapseDetailSearch">
                <div class="card">
                    <div class="card-body">
                        <input class="form-control mb-2" type="search" name= "location" placeholder="開催場所" aria-label="Search">
                        <label class="form-label mb-2">ライブ開催日</label>
                        <select name="year" class="form-control mb-2" id="searchYear">
                            <option value="">開催年▽</option>
                        </select>
                        <label class=" ms-3 mb-2">さらに詳細な日付検索</label>
                        <div class="ms-3 row mb-2">
                            <div class="col-4">
                                <input type="date" class="form-control" name="date_start">
                            </div>
                            <div class="col-2">
                                <span>から</span>
                            </div>
                            <div class="col-4">
                                <input type="date" class="form-control" name="date_end">
                            </div>
                            <div class="col-2">
                                <span>まで</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button class="btn btn-outline-success col-12 d-flex" type="submit">検索</button>
        </form>
        <table class="table table-striped table-hover my-2">
            <tbody>
                <th scope="col">ライブ名</th>
                <th scope="col">開催日</th>
                <th scope="col">場所</th>
                <th scope="col">開始時間</th>
                <% for(let live of lives) {%>
                    <tr>
                    <td><a href="/lives/<%= live._id %>"><%= live.name %></a></td>
                    <% const days = ["日", "月", "火", "水", "木", "金", "土"] %>
                    <% const dateString = `${live.date.getFullYear()}年${live.date.getMonth() + 1}月${live.date.getDate()}日 (${days[live.date.getDay()]})` %>
                    <td><%= dateString %></td>
                    <td><%= live.location %></td>
                    <td><%= live.time %></td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
<script src="/javascript/liveIndex.js"></script>