<% layout("layouts/boilerplate") %>
<link rel="stylesheet" href="/stylesheets/newLive.css">
<div class="row col-12 col-md-6 offset-md-3">
    <h1>ライブ新規作成フォーム</h1>
    <h3 id = "msg"></h3>
    <form action="/lives" method="POST" class = "validation" novalidate>
        <div>
            <label for="name" class="col-form-label me-3">ライブ名</label>
            <input type="text" id="name" name="live[name]" class="form-control" required>
            <div class="valid-feedback">
                OK!
            </div>
        </div>
        <div>
            <label for="date" class="col-form-label" multiple>開催日</label>
            <input type="date" id = "date" name="live[date]" class = "form-control" required>
            <div class="valid-feedback">
                OK!
            </div>
        </div>
        <div>
            <label for="place" class="col-form-label" multiple>開催場所</label>
            <input type="text" id = "location" name="live[location]" class = "form-control" required>
            <div class="valid-feedback">
                OK!
            </div>
        </div>
        <div>
            <label for="time" class="col-form-label" multiple>開始時間</label>
            <input type="time" id = "time" name="live[time]" class = "form-control" value="18:15" required>
            <div class="valid-feedback">
                OK!
            </div>
        </div>
        <div>
            <label for="playlistUrl" class="col-form-label">SE用：SpotifyプレイリストURL</label>
            <input type="text" id = "playlistUrl" name="live[playlistUrl]" class = "form-control" placeholder = "例：https://open.spotify.com/playlist/ID" required>
            <div class="valid-feedback">
                OK!
            </div>
        </div>
            <div class="my-3">
                <label class="col-form-label">マイク番号初期配置</label>
                <div class="alert alert-info mb-1">マイクの初期配置を指定してください。上から順に入力します。上が下手、下が上手です。</div>
                <div class="stage-wrapper">
                    <div class="stage-area">
                        <div class="stage-label stage-label-top">ステージ下手<br><small class="muted">（ステージ向かって左）</small></div>
                        <div class="mb-2 d-flex gap-2 justify-content-end">
                            <button id="reverseNumbers" class="btn btn-sm btn-outline-secondary" type="button">マイク番号を上下反転</button>
                            <button id="reverseParts" class="btn btn-sm btn-outline-secondary" type="button">パートを上下反転</button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 25%;">マイク番号</th>
                                        <th>パート</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% const defaultParts = ['サード','セカンド','トップ','リード','ベース','ボイパ']; %>
                                    <% for(let j = 6; j >= 1; j--){ %>
                                        <% const pos = 7 - j; %>
                                        <tr>
                                            <td>
                                                <input type="text" name="live[micNumber][]" class="form-control form-control-sm" id="<%= `liveMicNumber-${j}` %>" value="<%= pos %>">
                                            </td>
                                            <td>
                                                <input type="text" name="live[micPart][]" class="form-control form-control-sm" id="<%= `liveMicPart-${j}` %>" value="<%= defaultParts[pos-1] %>">
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div class="stage-label stage-label-bottom">ステージ上手<br><small class="muted">（ステージ向かって右）</small></div>
                    </div>
                    <div class="audience-label">客席</div>
                </div>
            </div>

        <button type="submit" class="btn btn-success mt-3" id = "submitButton">ライブを新規作成</button>
    </form>
</div>
<script src="/javascript/validateForms.js"></script>
<script src="/javascript/liveMicControls.js"></script>
