<% layout("layouts/boilerplate") %>
<% layout("layouts/boilerplate") %>
<div class="row">
    <div class="col-12 col-md-8 offset-md-2">
        <h1>ライブ一覧 - 検索結果"<%= livename %>"</h1>
        <form action = "/lives/search" class="col-md-6 d-flex col-12" role="search">
            <input class="form-control me-2" type="search" name= "q" placeholder="ライブ名で検索" aria-label="Search">
            <button class="btn btn-outline-success col-2" type="submit">検索</button>
        </form>
        <table class="table table-striped table-hover my-2">
            <tbody>
                <th scope="col">ライブ名</th>
                <th scope="col">開催日</th>
                <th scope="col">場所</th>
                <th scope="col">開始時間</th>
                <% for(let live of lives) {%>
                    <tr>
                    <td><a href="/lives/<%= live._id %>"><%= live.name %></a></td>
                    <% const days = ["日", "月", "火", "水", "木", "金", "土"] %>
                    <% const dateString = `${live.date.getFullYear()}年${live.date.getMonth() + 1}月${live.date.getDate()}日 (${days[live.date.getDay()]})` %>
                    <td><%= dateString %></td>
                    <td><%= live.location %></td>
                    <td><%= live.time %></td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
